# Copy to .env and adjust as needed. All values are optional; sane
# defaults are baked into app/config.py.

# --- Storage ---
# STORAGE_DIR=./storage
# MAX_UPLOAD_BYTES=26214400
# SESSION_TTL_MINUTES=240

# --- NLP ---
# SPACY_MODEL=en_core_web_sm
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# CANONICALIZE_DISTANCE_THRESHOLD=0.35

# --- LLM provider for /api/graph/ask ---
# One of: ollama | openai | anthropic | none
LLM_PROVIDER=ollama

# ollama (local, matches the original notebook)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- CORS ---
# CORS_ORIGINS=*
